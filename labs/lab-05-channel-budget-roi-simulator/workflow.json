      "name": "Channel Scenarios",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        500,
        220
      ]
    },
    {
      "parameters": {
        "jsCode": "for (const x of items) { const j=x.json; j.cac=+(j.spend/j.customers).toFixed(2); j.roas=+(j.revenue/j.spend).toFixed(2); j.roi=+((j.revenue*j.gross_margin-j.spend)/j.spend).toFixed(2); j.volume_ok=j.customers>=10; } return items;"
      },
