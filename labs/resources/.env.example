# Copy to a local .env file and replace only the values used in your lab.
# Never commit .env or paste credentials into prompts, screenshots or source files.
FOUNDRY_PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>
FOUNDRY_MODEL_NAME=<language-model-deployment-name>
AZURE_SEARCH_ENDPOINT=https://<search-service>.search.windows.net
AZURE_SEARCH_INDEX=<index-name>
AZURE_SEARCH_VECTOR_FIELD=content_vector
AZURE_SEARCH_SEMANTIC_CONFIG=<semantic-configuration-name>
# SEARCH_API_KEY=<optional-training-key; prefer Search Index Data Reader with Entra ID>
CONTENTUNDERSTANDING_ENDPOINT=https://<foundry-resource>.services.ai.azure.com
# CONTENTUNDERSTANDING_KEY=<optional-ephemeral-training-key>
# SPEECH_KEY=<optional-ephemeral-training-key>
SPEECH_ENDPOINT=https://<resource>.cognitiveservices.azure.com
# TRANSLATOR_KEY=<optional-ephemeral-training-key>
TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com
TRANSLATOR_REGION=<resource-region>
