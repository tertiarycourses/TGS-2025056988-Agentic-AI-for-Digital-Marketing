{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["request_id", "summary", "entities", "sentiment_signal", "urgency", "evidence", "source_language", "translated_summary", "uncertainty"],
  "properties": {
    "request_id": {"type": ["string", "null"], "pattern": "^NS-[0-9]{4}$"},
    "summary": {"type": "string", "minLength": 10},
    "entities": {
      "type": "object",
      "required": ["asset_tag", "diagnostic_reference", "time_constraint"],
      "properties": {
        "asset_tag": {"type": ["string", "null"]},
        "diagnostic_reference": {"type": ["string", "null"]},
        "time_constraint": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "sentiment_signal": {"enum": ["positive", "neutral", "negative", "mixed", "uncertain"]},
    "urgency": {"enum": ["Low", "Normal", "High", "Critical", "Uncertain"]},
    "evidence": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "source_language": {"type": "string"},
    "translated_summary": {"type": ["string", "null"]},
    "uncertainty": {"type": "array", "items": {"type": "string"}},
    "processing": {
      "type": "object",
      "required": ["validation"],
      "properties": {
        "validation": {"enum": ["schema_ok"]},
        "translation_target": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
