    },
    {
      "parameters": {
        "jsCode": "for (const x of items) { const j=x.json; j.evidence_score=+(j.relevance*j.reliability*j.recency).toFixed(3); j.accepted=j.evidence_score>=0.60; j.rejection_reason=j.accepted?'':'Below 0.60 evidence threshold'; } return items;"
      },
