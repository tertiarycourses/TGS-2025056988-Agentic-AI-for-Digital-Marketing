      "parameters": {
        "jsCode": "for (const x of items) { const j=x.json; j.cac=+(j.spend/j.customers).toFixed(2); j.roas=+(j.revenue/j.spend).toFixed(2); j.roi=+((j.revenue*j.gross_margin-j.spend)/j.spend).toFixed(2); j.relative_lift=+((j.current_cv-j.baseline_cv)/j.baseline_cv).toFixed(3); j.low_volume=j.customers<5; } return items;"
      },
